# Store all text files with LF line endings in the repository,
# regardless of the contributor's operating system.
* text=auto eol=lf

# Windows batch scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no line-ending conversion and no textual diffs.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
