# UniFlow with Docker — settings TEMPLATE (committed). Copy it and fill it in:
#   Copy-Item .env.example .env
# deploy/.env is git-ignored: it holds passwords and keys. Never commit or share it.
# Generate long random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Trying it on your computer ------------------------------------------------------------
# These values are for Docker Desktop on your own computer (http://localhost:8000).
# Online (Render), the same settings are entered in Render's dashboard instead.
DJANGO_ALLOWED_HOSTS=localhost,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Locally there is no HTTPS, so don't redirect to it (online it stays on).
DJANGO_SECURE_SSL_REDIRECT=false
# The website (npm run dev) and where links in emails point.
FRONTEND_DOMAIN=localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Django --------------------------------------------------------------------------
DJANGO_SECRET_KEY=
ALLOWED_EMAIL_DOMAINS=student.aiu.edu.my
TIME_ZONE=Asia/Kuala_Lumpur
# Emails are printed in the backend's log (docker compose logs backend). To send them, use
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend with BREVO_API_KEY (docs/deployment.md).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=UniFlow <no-reply@uniflow.local>

# --- Database (the PostgreSQL container creates it the first time) -------------------------
# Online, Render gives the database as one DATABASE_URL instead.
DB_NAME=uniflow
DB_USER=uniflow
# Letters and digits only: it goes inside an address, where @ / : # would break it.
DB_PASSWORD=

# --- Privacy and files -------------------------------------------------------------------
MESSAGE_RETENTION_DAYS=60
MAX_UPLOAD_MB=10

# --- Background jobs (Inngest, M9.6j) --------------------------------------------------------
# Trying it in Docker: Inngest's dev server runs on your computer (backend/README.md), and the
# backend reaches it at this address. Online (Render) leave INNGEST_DEV out and set the two
# keys from Inngest Cloud (app.inngest.com) instead: the site won't start without them.
# Never commit the keys.
INNGEST_DEV=http://host.docker.internal:8288
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Where uploaded files are kept (M9.6h) --------------------------------------------------
# Empty: in Docker's "media" volume (fine on your computer). Online (Render) they must go to a
# PRIVATE Supabase Storage bucket, because the web service and the worker don't share a disk.
# From Supabase: Storage → Settings → S3 connection (guide: docs/10, section 21).
# The secret key can reach all of the project's storage: only ever in Render, never in git.
S3_BUCKET=
# e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=
# e.g. ap-southeast-1 (Singapore)
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI (Gemini, free tier) ----------------------------------------------------------------
GEMINI_API_KEY=
# Optional model lists (see backend/.env.example).
# AI_FAST_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview,gemini-flash-lite-latest
# AI_SMART_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-latest

# --- Telegram bot (optional) --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp connector -------------------------------------------------------------------
# The same secret is used by Django and the connector.
CONNECTOR_SECRET=
# UniFlow's own WhatsApp number (a dedicated SIM, never a personal one), with country code.
WHATSAPP_NUMBER=
JOIN_EVERY_SECONDS=300
