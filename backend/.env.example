# UniFlow backend environment — TEMPLATE (committed).
# Copy to backend/.env (git-ignored) and fill in your local values:
#   Copy-Item .env.example .env
# Syntax: KEY=VALUE, one per line. No inline comments after values.
# Real environment variables always override values in this file.

# --- Django -------------------------------------------------------------
# Settings module used by manage.py defaults to config.settings.dev.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend / CORS ---------------------------------------------------------
# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Accounts / email --------------------------------------------------------
# Only these email domains may register (comma-separated).
ALLOWED_EMAIL_DOMAINS=student.aiu.edu.my
# Where links in emails point (the website, without http://).
FRONTEND_DOMAIN=localhost:5173
# Development: print emails in the terminal. Production uses the SMTP backend (M10).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=UniFlow <no-reply@uniflow.local>

# --- Database (local MySQL 8.x, database created manually) ---------------
DB_NAME=uniflow
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Localization ---------------------------------------------------------
TIME_ZONE=Asia/Kuala_Lumpur

# --- Background jobs (Celery + Redis, from M4.1) ----------------------------
# Redis running in WSL. Use 127.0.0.1, not "localhost" (that waits ~20 s on Windows).
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
