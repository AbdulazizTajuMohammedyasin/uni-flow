# UniFlow backend environment — TEMPLATE (committed).
# Copy to backend/.env (git-ignored) and fill in your local values:
#   Copy-Item .env.example .env
# Syntax: KEY=VALUE, one per line. No inline comments after values.
# Real environment variables always override values in this file.

# --- Django -------------------------------------------------------------
# Settings module used by manage.py defaults to config.settings.dev.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend / CORS ---------------------------------------------------------
# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (local MySQL 8.x, database created manually) ---------------
DB_NAME=uniflow
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Localization ---------------------------------------------------------
TIME_ZONE=Asia/Kuala_Lumpur
