# UniFlow backend environment — TEMPLATE (committed).
# Copy to backend/.env (git-ignored) and fill in your local values:
#   Copy-Item .env.example .env
# Syntax: KEY=VALUE, one per line. No inline comments after values.
# Real environment variables always override values in this file.

# --- Django -------------------------------------------------------------
# Settings module used by manage.py defaults to config.settings.dev.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend / CORS ---------------------------------------------------------
# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Accounts / email --------------------------------------------------------
# Only these email domains may register (comma-separated).
ALLOWED_EMAIL_DOMAINS=student.aiu.edu.my
# Where links in emails point (the website, without http://).
FRONTEND_DOMAIN=localhost:5173
# Development: print emails in the terminal. Production sends through Brevo's API (Render's
# free plan blocks SMTP): EMAIL_BACKEND=anymail.backends.brevo.EmailBackend plus BREVO_API_KEY,
# and DEFAULT_FROM_EMAIL must be a sender verified in Brevo.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=UniFlow <no-reply@uniflow.local>
BREVO_API_KEY=

# --- Database (local MySQL 8.x, database created manually) ---------------
# Online, Render's PostgreSQL is used instead: DATABASE_URL=postgresql://… (see docs/10).
DB_NAME=uniflow
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Localization ---------------------------------------------------------
TIME_ZONE=Asia/Kuala_Lumpur

# --- Background jobs (Inngest, from M9.6j; it replaced Celery and Redis) --------
# On your laptop: true = Inngest's dev server (see backend/README.md). Online it is false,
# and Inngest Cloud's INNGEST_SIGNING_KEY and INNGEST_EVENT_KEY are set instead.
INNGEST_DEV=true

# --- Files (timetable images, PDFs, spreadsheets; from M4.4) ------------------
MAX_UPLOAD_MB=10
# Where they are kept (M9.6h). Empty S3_BUCKET: in backend/media/ (git-ignored). Filled in: in a
# private Supabase Storage bucket, as online (setup: docs/10, section 21). Tests always use
# the disk. The secret key can reach all of the project's storage: never commit it.
S3_BUCKET=
# e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=
# e.g. ap-southeast-1
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Privacy (from M4.5) -------------------------------------------------------
# Message text and timetable files are deleted after this many days.
MESSAGE_RETENTION_DAYS=60

# --- AI (from M5.1) ---------------------------------------------------------------
# Get a key at https://aistudio.google.com (free tier). Never commit the real key.
GEMINI_API_KEY=
# Optional: the models, tried in this order. On the free tier each model has its own daily
# allowance: when one is used up (or busy), the next one answers. Check them with
#   pipenv run python manage.py check_ai
# AI_FAST_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview,gemini-flash-lite-latest
# AI_SMART_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-latest
# (Older single settings still work and go first: AI_FAST_MODEL=… / AI_SMART_MODEL=…)

# --- Telegram bot (from M6.1) ----------------------------------------------------
# Create the bot with @BotFather in Telegram and paste its token. Never commit it.
TELEGRAM_BOT_TOKEN=
# Any long random text (letters, digits, _ and -). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp connector (from M6.2) -------------------------------------------------
# Shared with the connector; it signs its requests with it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTOR_SECRET=
# UniFlow's WhatsApp number (the connector's), shown to students who add it to a group without
# an invite link, e.g. +60123456789.
UNIFLOW_WHATSAPP_NUMBER=

# --- Push notifications to the mobile app (from M9.15) -----------------------------------
# expo.dev -> Account settings -> Access tokens. Empty: nothing is pushed to phones.
EXPO_ACCESS_TOKEN=
