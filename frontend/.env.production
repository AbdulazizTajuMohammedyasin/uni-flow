# Used by `npm run build` (Vercel builds with it); `npm run dev` ignores this file.
# Online, the website calls the API on its OWN address: Vercel forwards /api/ to Render
# (see vercel.json), so the browser only ever talks to one site and login cookies work in
# every browser. No secrets here: this file is committed.
VITE_API_URL=/api/v1
