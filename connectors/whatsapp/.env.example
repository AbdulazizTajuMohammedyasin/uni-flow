# UniFlow WhatsApp connector — TEMPLATE (committed).
# Copy to connectors/whatsapp/.env (git-ignored) and fill in:
#   Copy-Item .env.example .env

# Where the UniFlow backend runs (its /api/v1 address).
UNIFLOW_API_URL=http://127.0.0.1:8000/api/v1

# The same value as CONNECTOR_SECRET in backend/.env.
CONNECTOR_SECRET=

# UniFlow's own WhatsApp number, with the country code (only used to log in the first
# time). Use a dedicated SIM, never a personal number: WhatsApp may ban it.
WHATSAPP_NUMBER=

# Where the login session is kept (git-ignored; anyone with it is logged in as UniFlow).
AUTH_DIR=./auth

# How often to look for new groups to join (seconds). One group is joined per round.
JOIN_EVERY_SECONDS=300

# Files larger than this are skipped (the same limit as backend/.env).
MAX_UPLOAD_MB=10

# Post the "Hello! This is UniFlow…" notice when joining a group (true), or join silently
# (false, the default).
SEND_JOIN_NOTICE=false
